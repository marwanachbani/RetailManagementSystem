<Window x:Class="RMS.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RMS.WPF.Views"
        xmlns:viewModels="clr-namespace:RMS.WPF.ViewModels"
        xmlns:settings="clr-namespace:RMS.WPF.Settings"
        Title="Retail Management System" 
        Height="700" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Style="{StaticResource ModernWindowStyle}"
        mc:Ignorable="d">
    
    <Grid>
        <Grid.Resources>
            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ProductListViewModel}">
                <views:ProductListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:InventoryListViewModel}">
                <views:InventoryListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:CustomerListViewModel}">
                <views:CustomerListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SupplierListViewModel}">
                <views:SupplierListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:PurchaseOrdersViewModel}">
                <views:PurchaseOrdersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SalesViewModel}">
                <views:SalesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
                <settings:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:AuditLogViewModel}">
                <views:AuditLogView />
            </DataTemplate>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sidebar -->
        <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}" Padding="0,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,0,20,24">
                    <TextBlock Text="Retail Management"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <TextBlock Text="Enterprise Desktop ERP"
                               Foreground="#9CA3AF"
                               FontSize="11"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="12,0">
                    <Button Content="Dashboard"
                            Command="{Binding NavigateDashboardCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="Products"
                            Command="{Binding NavigateProductsCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="Inventory"
                            Command="{Binding NavigateInventoryCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="Sales"
                            Command="{Binding NavigateSalesCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="Customers"
                            Command="{Binding NavigateCustomersCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="Suppliers"
                            Command="{Binding NavigateSuppliersCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,4"/>
                     <Button Content="Purchasing"
                             Command="{Binding NavigatePurchasingCommand}"
                             Style="{StaticResource SidebarButtonStyle}"
                             Margin="0,0,0,4"/>
                     <Button Content="Reports"
                             Command="{Binding NavigateReportsCommand}"
                             Style="{StaticResource SidebarButtonStyle}"
                             Margin="0,0,0,4"/>
                      <Button Content="Settings"
                              Command="{Binding NavigateSettingsCommand}"
                              Style="{StaticResource SidebarButtonStyle}"
                              Margin="0,0,0,4"/>
                       <Button Content="Audit Log"
                              Command="{Binding NavigateAuditCommand}"
                              Style="{StaticResource SidebarButtonStyle}"
                              Margin="0,0,0,4"/>
                       <Button Content="Logout"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,4"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,8">
                    <TextBlock Text="v1.0.0"
                               Foreground="#6B7280"
                               FontSize="10"
                               HorizontalAlignment="Left"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource SurfaceBrush}" Padding="20,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentViewTitle}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding CurrentBreadcrumb}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUserName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,12,0"/>
                        <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="999" Padding="8,4">
                            <TextBlock Text="Online" FontSize="11" Foreground="{StaticResource PrimaryDarkBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource BackgroundBrush}"
                    Padding="20">
                <ContentControl Content="{Binding CurrentViewModel}"/>
            </Border>
        </Grid>

        <Border Grid.Column="1" Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="Ready for fast checkout and order processing" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
