<Window x:Class="RMS.WPF.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retail Management System — Login"
        Height="480"
        Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Border Background="{StaticResource SurfaceBrush}"
                CornerRadius="12"
                Padding="36"
                Width="360"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect ShadowDepth="2"
                                  BlurRadius="12"
                                  Opacity="0.08"
                                  Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Retail Management System"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Enterprise Desktop ERP"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,28"/>

                <TextBlock Text="User Name"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <TextBox x:Name="UserNameTextBox"
                         Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0,0,0,12"
                         KeyDown="OnUsernameOrPasswordKeyDown"/>

                <TextBlock Text="Password"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource ModernPasswordBoxStyle}"
                                 Visibility="{Binding ShowPassword, Converter={StaticResource InvertBooleanToVisibilityConverter}}"
                                 KeyDown="OnUsernameOrPasswordKeyDown"/>
                    <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Visibility="{Binding ShowPassword, Converter={StaticResource BooleanToVisibilityConverter}}"
                             KeyDown="OnUsernameOrPasswordKeyDown"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox IsChecked="{Binding ShowPassword}" Content="Show Password" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <CheckBox IsChecked="{Binding RememberMe}" Content="Remember Me" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="16,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="ErrorTextBlock"
                           Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           Visibility="Collapsed"/>

                <Button Content="Login"
                        Command="{Binding LoginCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch"/>

                <TextBlock Text="Loading..."
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           Margin="0,8,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
