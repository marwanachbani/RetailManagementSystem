<Window x:Class="RMS.WPF.Views.StockAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Stock Adjustment"
        Height="400"
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding ProductInfo}" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="1" Text="{Binding CurrentQuantity, StringFormat='Current Quantity: {0}'}" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Text="Operation:" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="3" ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="4" Text="Amount / New Quantity:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="5" Text="{Binding AdjustmentAmount, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>

        <TextBlock Grid.Row="6" Text="{Binding NewQuantity, StringFormat='New Quantity: {0}'}" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="7" Text="Reason:" Margin="0,0,0,5"/>
        <TextBox Grid.Row="8" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

        <TextBlock Grid.Row="9" Text="{Binding StatusMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="100" Margin="0,0,10,0" Command="{Binding SaveCommand}"/>
            <Button Content="Cancel" Width="100" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
