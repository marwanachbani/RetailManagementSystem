<Window x:Class="RMS.WPF.Views.CreateSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="New Sale"
        Height="720"
        Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="New Sale — Select Products" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <Border Grid.Column="1"
                        Background="{StaticResource PrimaryLightBrush}"
                        CornerRadius="999"
                        Padding="10,4"
                        Visibility="{Binding IsSaleCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Sale Completed" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content: Catalog + Cart -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Product Catalog -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Product Catalog" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="16,12,16,8"/>

                    <!-- Type to filter, or scan a barcode and press Enter to add it straight to the cart -->
                    <TextBox Grid.Row="1"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Margin="16,0,16,8">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding ScanBarcodeCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Pick a product from the list (double-click or the Add button), no need to search first -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Products}"
                             SelectedItem="{Binding SelectedProduct}"
                             Margin="8,0,8,8"
                             BorderThickness="0">
                        <ListBox.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding AddSelectedToCartCommand}"/>
                        </ListBox.InputBindings>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding CategoryName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SalePrice, StringFormat={}{0:C2}}" VerticalAlignment="Center" Margin="8,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Button Grid.Column="3"
                                            Content="+ Add"
                                            Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="8,3"
                                            FontSize="11"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT: Cart + Totals -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Cart" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="16,12,16,8"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedCartItem}"
                             Margin="8,0,8,8"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                                    <!-- Quantity stepper -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                        <Button Content="−"
                                                Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="6,0" FontSize="12" Width="26"/>
                                    <TextBlock Text="{Binding Quantity}" Width="28" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <Button Content="+"
                                                Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="6,0" FontSize="12" Width="26"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{Binding TotalPrice, StringFormat={}{0:C2}}" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <Button Grid.Column="3"
                                            Content="×"
                                            Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Padding="4,2"
                                            FontSize="11"
                                            Width="28"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Totals -->
                    <StackPanel Grid.Row="2" Margin="16,12,16,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Discount %:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding DiscountPercentage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Width="80"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding SubTotal, StringFormat='SubTotal: {0:C2}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock Text="{Binding DiscountAmount, StringFormat='Discount: {0:C2}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock Text="{Binding TaxAmount, StringFormat='Tax: {0:C2}'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock Text="{Binding TotalAmount, StringFormat='Total: {0:C2}'}" FontWeight="Bold" FontSize="20" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Actions -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <DockPanel LastChildFill="False">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="400"
                           FontSize="12"/>

                <!-- Before completion: Cancel / Complete Sale -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                            Visibility="{Binding IsSaleCompleted, Converter={StaticResource InvertBooleanToVisibilityConverter}}">
                    <Button Content="Cancel"
                            Width="100"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"/>
                    <Button Content="Complete Sale"
                            Width="120"
                            Command="{Binding CompleteSaleCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>

                <!-- After completion: receipt preview actions -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                            Visibility="{Binding IsSaleCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="Close"
                            Width="100"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"/>
                    <Button Content="Print Receipt"
                            Width="120"
                            Command="{Binding PrintReceiptCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Margin="0,0,8,0"/>
                    <Button Content="New Sale"
                            Width="120"
                            Command="{Binding StartNewSaleCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
