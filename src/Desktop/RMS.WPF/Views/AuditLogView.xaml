<UserControl x:Class="RMS.WPF.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.expression/blend/2008"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="From:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <DatePicker SelectedDate="{Binding FromDate}" Margin="0,0,12,0" Width="140"/>
                <TextBlock Text="To:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <DatePicker SelectedDate="{Binding ToDate}" Margin="0,0,12,0" Width="140"/>
                <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Width="200" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,12,0"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Module:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox ItemsSource="{Binding Modules}" SelectedItem="{Binding FilterModule}" Width="150" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,12,0"/>
                <TextBlock Text="Action:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding FilterAction}" Width="150" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,12,0"/>
                <TextBlock Text="User:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Text="{Binding FilterUserId, UpdateSourceTrigger=PropertyChanged}" Width="180" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,12,0"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" FontSize="12"/>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding AuditLogs}"
                      SelectedItem="{Binding SelectedEntry}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Style="{StaticResource ModernDataGridStyle}"
                      BorderThickness="0"
                      RowHeight="40">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150"/>
                    <DataGridTextColumn Header="User" Binding="{Binding UserName}" Width="120"/>
                    <DataGridTextColumn Header="Module" Binding="{Binding Module}" Width="100"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="120"/>
                    <DataGridTextColumn Header="Entity" Binding="{Binding Entity}" Width="100"/>
                    <DataGridTextColumn Header="Entity Id" Binding="{Binding EntityId}" Width="130"/>
                    <DataGridTemplateColumn Header="Details" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="View" Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="8,3" FontSize="11"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
