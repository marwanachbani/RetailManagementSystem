<UserControl x:Class="RMS.WPF.Settings.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:settings="clr-namespace:RMS.WPF.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=settings:GeneralSettingsViewModel}">

    <Border Style="{StaticResource CardBorderStyle}" MaxWidth="760">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Store Name" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Phone Number" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Email" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>

                <Label Grid.Row="3" Grid.Column="0" Content="Website" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>

                <Label Grid.Row="4" Grid.Column="0" Content="Tax Number" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TaxNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>

                <Label Grid.Row="5" Grid.Column="0" Content="Currency" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding Currency}" Style="{StaticResource ModernComboBoxStyle}"/>

                <Label Grid.Row="6" Grid.Column="0" Content="Time Zone" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TimeZone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>

                <Label Grid.Row="7" Grid.Column="0" Content="Language" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language}" Style="{StaticResource ModernComboBoxStyle}"/>

                <Label Grid.Row="8" Grid.Column="0" Content="Date Format" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding DateFormatOptions}" SelectedItem="{Binding DateFormat}" Style="{StaticResource ModernComboBoxStyle}"/>

                <Label Grid.Row="9" Grid.Column="0" Content="Time Format" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <ComboBox Grid.Row="9" Grid.Column="1" ItemsSource="{Binding TimeFormatOptions}" SelectedItem="{Binding TimeFormat}" Style="{StaticResource ModernComboBoxStyle}"/>

                <Label Grid.Row="10" Grid.Column="0" Content="Number Format" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding NumberFormat, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
