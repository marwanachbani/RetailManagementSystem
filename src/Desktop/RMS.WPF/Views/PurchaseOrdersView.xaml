<UserControl x:Class="RMS.WPF.Views.PurchaseOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:RMS.WPF.Views"
             xmlns:viewModels="clr-namespace:RMS.WPF.ViewModels"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type viewModels:PurchaseHistoryViewModel}">
            <views:PurchaseHistoryView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Purchase Orders" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Create and manage supplier orders" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="New Purchase Order" Command="{Binding NewPurchaseOrderCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Search and Filters -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters}" SelectedIndex="{Binding SelectedStatusFilter, Mode=TwoWay}" Width="140" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
        </Grid>

        <!-- Table -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding PurchaseOrders}"
                      SelectedItem="{Binding SelectedOrder}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Style="{StaticResource ModernDataGridStyle}"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PO Number" Binding="{Binding PurchaseNumber}" Width="140"/>
                    <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="180"/>
                    <DataGridTextColumn Header="Date" Binding="{Binding OrderDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="160"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                    <DataGridTextColumn Header="SubTotal" Binding="{Binding SubTotal, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="Tax" Binding="{Binding TaxAmount, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=C}" Width="110"/>
                    <DataGridTextColumn Header="Invoice" Binding="{Binding SupplierInvoiceNumber}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Expander Grid.Row="3" Header="Purchase History" IsExpanded="{Binding IsHistoryExpanded}" Margin="0,12,0,0">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,8,0,0" Padding="0">
                <ContentControl Content="{Binding HistoryViewModel}" />
            </Border>
        </Expander>

        <!-- Footer -->
        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Edit" Command="{Binding EditPurchaseOrderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Receive Goods" Command="{Binding ReceiveGoodsCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Cancel" Command="{Binding CancelPurchaseOrderCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Print" Command="{Binding PrintCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,24,0"/>
                <Button Content="View History" Command="{Binding ViewHistoryCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Prev" Command="{Binding PreviousPageCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding PageNumber}" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="/" VerticalAlignment="Center" FontSize="13" Margin="4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="Next" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
