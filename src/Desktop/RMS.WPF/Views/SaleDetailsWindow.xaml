<Window x:Class="RMS.WPF.Views.SaleDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sale Details"
        Height="560"
        Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        Style="{StaticResource ModernWindowStyle}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Sale Details" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Sale.SaleNumber, StringFormat='Sale # {0}'}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Sale.SaleDate, StringFormat='Date: {0:yyyy-MM-dd HH:mm}'}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Sale.Status, StringFormat='Status: {0}'}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Sale.SubTotal, StringFormat='SubTotal: {0:C2}'}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding Sale.DiscountAmount, StringFormat='Discount: {0:C2}'}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Sale.TaxAmount, StringFormat='Tax: {0:C2}'}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding Sale.TotalAmount, StringFormat='Total: {0:C2}'}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Style="{StaticResource ModernDataGridStyle}"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="70"/>
                    <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat=C}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource ErrorBrush}" Margin="0,12,0,0" FontSize="12"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" Click="OnCloseClicked" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
