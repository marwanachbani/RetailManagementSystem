<UserControl x:Class="RMS.WPF.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="10">
            <TextBlock Text="Sales"
                       FontSize="20"
                       FontWeight="Bold"
                       DockPanel.Dock="Left"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,5,0"/>

                <Button Content="New Sale"
                        Command="{Binding NewSaleCommand}"/>
            </StackPanel>
        </DockPanel>

        <!-- Status -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Margin="10,0,10,10"
                   Foreground="Gray"/>

        <!-- Table -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Sales}"
                  SelectedItem="{Binding SelectedSale}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Sale Number" Binding="{Binding SaleNumber}" />
                <DataGridTextColumn Header="Date" Binding="{Binding SaleDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                <DataGridTextColumn Header="SubTotal" Binding="{Binding SubTotal, StringFormat=C}" />
                <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, StringFormat=C}" />
                <DataGridTextColumn Header="Tax" Binding="{Binding TaxAmount, StringFormat=C}" />
                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat=C}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10">
            <Button Content="View History"
                    Command="{Binding ViewHistoryCommand}"
                    Margin="0,0,20,0"/>

            <Button Content="Prev"
                    Command="{Binding PreviousPageCommand}"
                    Margin="0,0,5,0"/>

            <TextBlock Text="{Binding PageNumber}" VerticalAlignment="Center"/>
            <TextBlock Text="/" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="5,0"/>

            <Button Content="Next"
                    Command="{Binding NextPageCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
