<UserControl x:Class="RMS.WPF.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:settings="clr-namespace:RMS.WPF.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=settings:SettingsViewModel}">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type settings:GeneralSettingsViewModel}">
            <settings:GeneralSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:StoreSettingsViewModel}">
            <settings:StoreSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:ReceiptSettingsViewModel}">
            <settings:ReceiptSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:SalesSettingsViewModel}">
            <settings:SalesSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:InventorySettingsViewModel}">
            <settings:InventorySettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:PurchasingSettingsViewModel}">
            <settings:PurchasingSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:ReportSettingsViewModel}">
            <settings:ReportSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:StorageSettingsViewModel}">
            <settings:StorageSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:BackupSettingsViewModel}">
            <settings:BackupSettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type settings:AppearanceSettingsViewModel}">
            <settings:AppearanceSettingsView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Section navigation -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource SidebarBrush}" Padding="0,16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Settings" Foreground="White" FontSize="18" FontWeight="Bold" Margin="20,0,0,16"/>
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,8" Margin="0,2" CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource SidebarTextBrush}" FontSize="14"/>
                                    <TextBlock Text="●" Foreground="{StaticResource WarningBrush}" FontSize="10" Margin="6,0,0,0"
                                               Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Section header + toolbar -->
        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding SelectedSection.Title}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding SelectedSection.Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FEF3C7" CornerRadius="6" Padding="10,6" Margin="0,0,12,0"
                            Visibility="{Binding SelectedSection.IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Unsaved changes" FontSize="12" Foreground="#92400E"/>
                    </Border>
                    <Button Content="Restore Defaults"
                            Command="{Binding SelectedSection.RestoreDefaultsCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Cancel"
                            Command="{Binding SelectedSection.CancelCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Save"
                            Command="{Binding SelectedSection.SaveCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Section content -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <ContentControl Content="{Binding SelectedSection}"/>

                <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="6"
                        Visibility="{Binding SelectedSection.Notification, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#D1FAE5"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSection.HasError}" Value="True">
                                    <Setter Property="Background" Value="#FEE2E2"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SelectedSection.Notification}" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#065F46"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSection.HasError}" Value="True">
                                        <Setter Property="Foreground" Value="#991B1B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
