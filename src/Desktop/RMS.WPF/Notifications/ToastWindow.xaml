<Window x:Class="RMS.WPF.Notifications.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Height="80"
        Width="350"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12"
            Effect="{StaticResource DropShadowEffect}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="4" CornerRadius="2" Margin="0,0,8,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                <Setter Property="Background" Value="#F59E0B"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Error">
                                <Setter Property="Background" Value="#EF4444"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                <Setter Property="Background" Value="#DC2626"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Success">
                                <Setter Property="Background" Value="#10B981"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="40"/>
            </StackPanel>
            <Button Grid.Column="2" Content="✕" Width="20" Height="20" Padding="0" VerticalAlignment="Top"
                    Click="OnCloseClicked" Style="{StaticResource FlatButtonStyle}"/>
        </Grid>
    </Border>
</Window>
