<UserControl x:Class="RMS.WPF.Views.InventoryListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Margin="10">
            <TextBlock Text="Inventory"
                       FontSize="20"
                       FontWeight="Bold"
                       DockPanel.Dock="Left"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBox Width="200"
                         Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,10,0"/>

                <Button Content="Search"
                        Command="{Binding SearchCommand}"
                        Margin="0,0,5,0"/>

                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,5,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Status -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   Margin="10,0,10,10"
                   Foreground="Gray"/>

        <!-- Table -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Product ID" Binding="{Binding ProductId}" />
                <DataGridTextColumn Header="Current Quantity" Binding="{Binding CurrentQuantity}" />
                <DataGridTextColumn Header="Low Stock Threshold" Binding="{Binding LowStockThreshold}" />
                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" />
                <DataGridTextColumn Header="Last Updated" Binding="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10">
            <Button Content="Adjust Stock"
                    Command="{Binding AdjustStockCommand}"
                    Margin="0,0,5,0"/>

            <Button Content="View History"
                    Command="{Binding ViewHistoryCommand}"
                    Margin="0,0,20,0"/>

            <Button Content="Prev"
                    Command="{Binding PreviousPageCommand}"
                    Margin="0,0,5,0"/>

            <TextBlock Text="{Binding PageNumber}" VerticalAlignment="Center"/>
            <TextBlock Text="/" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="5,0"/>

            <Button Content="Next"
                    Command="{Binding NextPageCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
