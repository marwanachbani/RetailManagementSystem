<UserControl x:Class="RMS.WPF.Settings.FolderSettingRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:settings="clr-namespace:RMS.WPF.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=settings:FolderSettingRowViewModel}">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Foreground="{StaticResource SuccessBrush}" FontSize="11" Margin="0,2,0,0"
                           Visibility="{Binding Exists, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Run Text="✓ Exists"/>
                </TextBlock>
                <TextBlock Foreground="{StaticResource ErrorBrush}" FontSize="11" Margin="0,2,0,0"
                           Visibility="{Binding Exists, Converter={StaticResource InvertBooleanToVisibilityConverter}}">
                    <Run Text="✗ Not found (will be created)"/>
                </TextBlock>
            </StackPanel>

            <TextBox Grid.Column="1" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" VerticalAlignment="Center" Margin="0,0,8,0"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Browse…" Command="{Binding BrowseCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                <Button Content="Open" Command="{Binding OpenCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0"/>
                <Button Content="Default" Command="{Binding RestoreDefaultCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
