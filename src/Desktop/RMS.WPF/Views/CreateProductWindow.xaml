<Window x:Class="RMS.WPF.Views.CreateProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Create Product"
        Height="450"
        Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="New Product"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- Form -->
        <StackPanel Grid.Row="1">

            <TextBlock Text="Name"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,10"/>

            <TextBlock Text="SKU"/>
            <TextBox Text="{Binding SKU, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Price"/>
            <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,10"/>

            <TextBlock Text="Stock Quantity"/>
            <TextBox Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,10"/>

            <CheckBox Content="Active"
                      IsChecked="{Binding IsActive}"
                      Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancel"
                    Width="100"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Save"
                    Width="100"
                    Command="{Binding SaveCommand}"/>
        </StackPanel>

    </Grid>
</Window>