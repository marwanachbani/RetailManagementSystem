<UserControl x:Class="RMS.WPF.Views.SupplierListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Suppliers" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Manage supplier relationships" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="New Supplier" Command="{Binding NewSupplierCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Search & Filters -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                         Width="300"
                         Style="{StaticResource ModernTextBoxStyle}"
                         Margin="0,0,12,0"
                         VerticalAlignment="Center"/>
                <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,12,0"/>
                <CheckBox Content="Include inactive" IsChecked="{Binding IncludeInactive}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Edit" Command="{Binding EditSupplierCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Details" Command="{Binding ViewDetailsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Deactivate" Command="{Binding DeactivateCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Reactivate" Command="{Binding ReactivateCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="2"
                   Text="{Binding StatusMessage}"
                   Margin="0,0,0,12"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"/>

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="3"
                     IsIndeterminate="True"
                     Height="4"
                     VerticalAlignment="Top"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Margin="0,0,0,4"
                     Foreground="{StaticResource PrimaryBrush}"
                     Background="Transparent"/>

        <!-- Table -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Suppliers}"
                      SelectedItem="{Binding SelectedSupplier}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Style="{StaticResource ModernDataGridStyle}"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding SupplierCode}" Width="120"/>
                    <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="200"/>
                    <DataGridTextColumn Header="Contact" Binding="{Binding ContactPerson}" Width="140"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="120"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200"/>
                    <DataGridTextColumn Header="City" Binding="{Binding City}" Width="120"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Prev" Command="{Binding PreviousPageCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding PageNumber}" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="/" VerticalAlignment="Center" FontSize="13" Margin="4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                <Button Content="Next" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
