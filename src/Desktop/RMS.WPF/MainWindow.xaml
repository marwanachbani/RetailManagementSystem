<Window x:Class="RMS.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RMS.WPF.Views"
        xmlns:viewModels="clr-namespace:RMS.WPF.ViewModels"
        Title="Retail Management System" Height="600" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.Resources>
            <DataTemplate DataType="{x:Type viewModels:ProductListViewModel}">
                <views:ProductListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:InventoryListViewModel}">
                <views:InventoryListView />
            </DataTemplate>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="#20242C" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Retail Management"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,0,0,24" />

                <StackPanel>
                    <Button Content="Products"
                            Command="{Binding NavigateProductsCommand}"
                            Height="40"
                            HorizontalContentAlignment="Left"
                            Padding="12,0"
                            Margin="0,0,0,8" />
                    <Button Content="Inventory"
                            Command="{Binding NavigateInventoryCommand}"
                            Height="40"
                            HorizontalContentAlignment="Left"
                            Padding="12,0"
                            Margin="0,0,0,8" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>
