<Window x:Class="RMS.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RMS.WPF.Views"
        xmlns:viewModels="clr-namespace:RMS.WPF.ViewModels"
        Title="Retail Management System" 
        Height="700" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Style="{StaticResource ModernWindowStyle}"
        mc:Ignorable="d">
    
    <Grid>
        <Grid.Resources>
            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ProductListViewModel}">
                <views:ProductListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:InventoryListViewModel}">
                <views:InventoryListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:CustomerListViewModel}">
                <views:CustomerListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SupplierListViewModel}">
                <views:SupplierListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:PurchaseOrdersViewModel}">
                <views:PurchaseOrdersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:SalesViewModel}">
                <views:SalesView />
            </DataTemplate>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource SidebarBrush}" Padding="0,16">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="20,0,20,24">
                    <TextBlock Text="Retail Management" 
                               Foreground="White" 
                               FontSize="18" 
                               FontWeight="Bold"/>
                    <TextBlock Text="Enterprise Desktop ERP" 
                               Foreground="#9CA3AF" 
                               FontSize="11" 
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top" Margin="12,0">
                    <Button Content="Dashboard" 
                            Command="{Binding NavigateDashboardCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="Products" 
                            Command="{Binding NavigateProductsCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="Inventory" 
                            Command="{Binding NavigateInventoryCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="Sales" 
                            Command="{Binding NavigateSalesCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="Customers" 
                            Command="{Binding NavigateCustomersCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="Suppliers" 
                            Command="{Binding NavigateSuppliersCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="Purchasing" 
                            Command="{Binding NavigatePurchasingCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,4"/>
                    <Button Content="Logout" 
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SidebarButtonStyle}"
                            Margin="0,0,0,4"/>
                </StackPanel>

                <!-- Footer -->
                <StackPanel DockPanel.Dock="Bottom" Margin="20,0,20,8">
                    <TextBlock Text="v1.0.0" 
                               Foreground="#6B7280" 
                               FontSize="10"
                               HorizontalAlignment="Left"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Border Grid.Column="1" 
                Background="{StaticResource BackgroundBrush}"
                Padding="20">
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </Border>
    </Grid>
</Window>
